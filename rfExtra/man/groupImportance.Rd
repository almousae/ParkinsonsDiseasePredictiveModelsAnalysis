\name{groupImportance}
\alias{groupImportance}

\title{Extract Group Variable Importance Measure}

\description{
  The extractor function for group variable importance measures 
  generated by \code{rfExtra::randomForest()}.
}

\usage{
groupImportance(x, class=NULL, scale=TRUE)
}

\arguments{
  \item{x}{An object of class \code{\link{randomForest}}}.
  \item{class}{For classification, which class the variable importance 
  should be calculated. Set class to \code{NULL} to get results over all 
  classes.}
  \item{scale}{Whether to scale permutation-based variable importance 
  (divided by the standard error).}
}

\value{
  A matrix of group importance measure, one row for each group of predictor variables. 
  Importance measures in terms of node impurity will not be calculated for group variable
  importance.
}

\seealso{
  \code{\link{randomForest}}, \code{\link{grpVarImpPlot}}
}

\references{
 Liaw, A. and Wiener, M. (2002), \emph{Classification and regression by randomForest}, R news 2(3), 18–22.
}

\examples{
\dontrun{
# Load library
library(rfExtra)

# Load data set
data = read.table(file = "https://archive.ics.uci.edu/ml/machine-learning-databases/
    parkinsons/parkinsons.data",
    sep = ",", header = TRUE, check.names = FALSE)
data = subset(data, select = -name)

# Set response variable
response = "status"

# Split data
predictor_vars = data[, colnames(data) != response]
predictor_vars = na.roughfix(predictor_vars)
response_var = data[, colnames(data) == response]

# Downsample to the smaller class size
response_var = as.factor(response_var)
min_size = min(table(response_var))
num_classes = length(table(response_var))

set.seed(1) # Set seed for reproducible results
rf = rfExtra::randomForest(x = predictor_vars, y = response_var,
                           groupImp = TRUE, ntree = 100000, sampsize = rep(min_size, num_classes),
                           varGroups=factor(c(rep('Group 1', 5), rep('Group 2', 11), rep('Group 3', 6))))
groupImportance(rf, scale=TRUE)
}
}
\keyword{classification}
\keyword{regression}


